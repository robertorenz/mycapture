{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myCapture",
  "version": "0.3.4",
  "identifier": "com.mycapture.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "moon",
        "url": "moon.html",
        "title": "myCapture",
        "width": 72,
        "height": 40,
        "minWidth": 40,
        "minHeight": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "shortDescription": "Jing-style screen capture",
    "category": "Productivity",
    "publisher": "Roberto Renz",
    "copyright": "Copyright © 2026 Roberto Renz. MIT License.",
    "homepage": "https://github.com/robertorenz/mycapture",
    "licenseFile": "../LICENSE",
    "longDescription": "Screenshots with annotations, screen video with your webcam, and instant copy or share links, launched from a little moon on the edge of your screen.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "startMenuFolder": "myCapture",
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQkEzMTUzQkJGNzY3NzgKUldSNFovZTdVekc2UUlmcUo5SEp2Nm9KdFpFaVdwR3B1R0xlNS9uaEJNTzJHMW5BdkR4aUNLQUYK",
      "endpoints": [
        "https://github.com/robertorenz/mycapture/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
